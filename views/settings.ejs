<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings</title>
    <link rel="stylesheet" href="../../css/settings.css">
    <link rel="stylesheet" href="/css/vouchers.css">
  
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-container">
        <a href="/" class="navbar-logo">VoucherApp</a>
        <ul class="navbar-menu">
            <li><a href="/" class="navbar-link">Home</a></li>
            <li><a href="/vouchers" class="navbar-link">Vouchers</a></li>
            <li><a href="/Settings" class="navbar-link">Settings</a></li>
            <li><a href="/logout" class="navbar-link">Logout</a></li>
        </ul>
        <div class="navbar-toggle" id="mobile-menu">
            <i class="fas fa-bars"></i>
        </div>
    </div>
</nav>
    <div class="container">
        <h1>Settings</h1>
        <form id="settingsForm" action="/settings" method="POST">
            <div class="form-group">
                <label for="maxExpiryTime">Max Expiry Time (Days):</label>
                <input type="number" id="maxExpiryTime" name="maxExpiryTime" value="<%= settings?.maxExpiryTime || 30 %>" required>
            </div>

            <div class="form-group">
                <label for="voucherWidth">Voucher Width (mm):</label>
                <input type="number" id="voucherWidth" name="voucherWidth" value="<%= settings?.voucherWidth || 100 %>" required>
            </div>

            <div class="form-group">
                <label for="voucherHeight">Voucher Height (mm):</label>
                <input type="number" id="voucherHeight" name="voucherHeight" value="<%= settings?.voucherHeight || 50 %>" required>
            </div>

            <div class="form-group">
                <label for="titleFontSize">Title Font Size:</label>
                <input type="number" id="titleFontSize" name="titleFontSize" value="<%= settings?.titleFontSize || 16 %>" required>
            </div>

            <div class="form-group">
                <label for="textFontSize">Text Font Size:</label>
                <input type="number" id="textFontSize" name="textFontSize" value="<%= settings?.textFontSize || 12 %>" required>
            </div>

            <button type="submit" id="saveButton">Save Settings</button>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById('settingsForm').addEventListener('submit', function (event) {
            event.preventDefault(); 

            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to save the settings?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, save it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    
                    this.submit();
                }
            });
        });
    </script>
</body>
</html>
