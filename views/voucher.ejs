<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vouchers</title>
    <link rel="stylesheet" href="/css/vouchers.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="icon" href="https://png.pngtree.com/png-clipart/20220530/original/pngtree-voucher-discount-vector-png-image_7768824.png" type="image/x-icon">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- SweetAlert2 CDN -->
    <style>
 
        .export-btn, .print-btn {
            background-color: #3085d6;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 15px;
            cursor: pointer;
            font-size: 14px;
            margin-right: 10px;
        }
        .export-btn:hover, .print-btn:hover {
            background-color: #2866b0;
        }
        .voucher-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            background-color: #f9f9f9;
        }
        .voucher-info {
            flex: 1;
        }
        .voucher-qr {
            margin-left: 20px;
        }
        .button-group {
            margin-left: 20px;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="navbar-container">
            <a href="/" class="navbar-logo">VoucherApp</a>
            <ul class="navbar-menu">
                <li><a href="/" class="navbar-link">Home</a></li>
                <li><a href="/vouchers" class="navbar-link">Vouchers</a></li>
                <li><a href="/settings" class="navbar-link">Settings</a></li>
                <li><a href="/logout" class="navbar-link">Logout</a></li>
            </ul>
            <div class="navbar-toggle" id="mobile-menu">
                <i class="fas fa-bars"></i>
            </div>
        </div>
    </nav>
    <div class="container">
        <header>
            <h1>Vouchers</h1>
        </header>
        <main>
            <section class="generate-section">
                <form action="/vouchers/generate" method="POST" class="generate-form" id="generate-form">
                    <button type="button" class="generate-btn" id="generate-btn">Generate New Voucher</button>
                </form>
            </section>
            <section class="vouchers-section">
                <ul class="voucher-list">
                    <% if (vouchers && vouchers.length > 0) { %>
                        <% vouchers.forEach(voucher => { %>
                            <li class="voucher-item">
                                <div class="voucher-info">
                                    <p><strong>Code:</strong> <%= voucher.code %></p>
                                    <p><strong>Generated Date:</strong> <%= new Date(voucher.generatedDate).toLocaleDateString() %></p>
                                    <p><strong>Expiry Date:</strong> <%= new Date(voucher.expiryDate).toLocaleDateString() %></p>
                                </div>
                                <div class="voucher-qr">
                                    <img src="<%= voucher.qrCode %>" alt="QR Code for <%= voucher.code %>" class="qr-code">
                                </div>
                                <div class="button-group">
                                    <form 
                                    action="/vouchers/export-pdf" 
                                    method="POST" 
                                    class="export-form" 
                                    style="display: inline;" 
                                    onsubmit="handleExportPDF(event, this)">
                                    <input type="hidden" name="voucherId" value="<%= voucher.id %>">
                                    <button type="submit" class="export-btn">Export as PDF</button>
                                </form>
                                    <button class="print-btn" onclick="printVoucher('<%= voucher.code %>')">Print</button>
                                </div>
                            </li>
                        <% }); %>
                    <% } else { %>
                        <li class="no-vouchers">No vouchers available.</li>
                    <% } %>
                </ul>
                <nav class="pagination">
                    <% if (totalPages > 1) { %>
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <a 
                                href="/vouchers?page=<%= i %>&limit=<%= limit %>" 
                                class="pagination-link <%= currentPage === i ? 'active' : '' %>">
                                <%= i %>
                            </a>
                        <% } %>
                    <% } %>
                </nav>
            </section>
        </main>
    </div>

    <script>
        // SweetAlert for confirmation before voucher generation
        document.getElementById('generate-btn').addEventListener('click', function (event) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to generate a new voucher!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, generate it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Submit the form if the user confirms
                    document.getElementById('generate-form').submit();
                }
            });
        });

        // Check for the success query parameter in the URL
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('success') && urlParams.get('success') === 'true') {
            Swal.fire({
                title: 'Success!',
                text: 'Voucher generated successfully.',
                icon: 'success',
                confirmButtonColor: '#3085d6',
                confirmButtonText: 'OK'
            });
        }

        // Function to print the voucher
        function printVoucher(code) {
            const printContent = `
                <div style="text-align: center; padding: 20px;">
                    <h1>Voucher Code: ${code}</h1>
                </div>
            `;
            const printWindow = window.open('', '_blank');
            printWindow.document.write(printContent);
            printWindow.document.close();
            printWindow.focus();
            printWindow.print();
            printWindow.close();
        }
        function handleExportPDF(event, form) {
        event.preventDefault(); // Prevent the default form submission
        const formAction = form.action; // Get the form action URL
        const formData = new FormData(form); // Prepare the form data

        // Add a 1-second delay
        setTimeout(() => {
            // Create a temporary form to simulate the delayed submission
            const tempForm = document.createElement('form');
            tempForm.action = formAction;
            tempForm.method = 'POST';

            // Append the form data fields
            for (const [key, value] of formData.entries()) {
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = key;
                input.value = value;
                tempForm.appendChild(input);
            }

            document.body.appendChild(tempForm);
            tempForm.submit(); // Submit the form
            document.body.removeChild(tempForm); // Clean up
        }, 1000);
    }
    </script>
</body>
</html>
